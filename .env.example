# ── Auth ───────────────────────────────────────────────────────────────────────
# Long-lived OAuth token from `claude setup-token` (Claude Max subscription required)
CLAUDE_CODE_OAUTH_TOKEN=

# Classic GitHub PAT — repo + workflow scopes
GH_TOKEN=

# ── Discord ────────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# Discord server (guild) ID
DISCORD_GUILD_ID=

# General channel — catch-all, mention required
DISCORD_CHANNEL_GENERAL=

# SimpleClaw self-maintenance channel — source edits → build → restart happen here
DISCORD_CHANNEL_SIMPLECLAW=

# Optional: channel where Gmail alert threads are posted (defaults to DISCORD_CHANNEL_GENERAL)
DISCORD_CHANNEL_MAIL_ALERTS=

# Optional: channel for wiki ingest (simpleclaw-wiki). Pure URL → URL ingest, other text → topic research.
DISCORD_CHANNEL_WIKI=

# Optional: root channel. No repo binding — spawns Claude Code at $HOME with full machine access.
# Owner-only: messages from any authorId other than DISCORD_OWNER_USER_ID are silently ignored here.
DISCORD_CHANNEL_ROOT=

# Discord user ID of the operator (the only allowed sender)
DISCORD_OWNER_USER_ID=

# ── Gmail ──────────────────────────────────────────────────────────────────────
# Single OAuth client used for all Gmail accounts.
# Create at: https://console.cloud.google.com/apis/credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Refresh tokens — one per Gmail account listed in simpleclaw.config.json (in order).
# Generate each token with: tsx scripts/gmail-auth.ts <email>
GMAIL_REFRESH_TOKEN_1=
GMAIL_REFRESH_TOKEN_2=
# Add GMAIL_REFRESH_TOKEN_3, _4, … as needed

# ── Polling ────────────────────────────────────────────────────────────────────
MAIL_POLL_INTERVAL_SEC=300

# ── Dashboard ──────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3200
DASHBOARD_SECRET=

# ── Paths ──────────────────────────────────────────────────────────────────────
DATA_DIR=
LOGS_DIR=
# Absolute path to LLM wiki directory (defaults to ~/coding-agent-wiki)
WIKI_DIR=

# ── Notion ─────────────────────────────────────────────────────────────────────
# Integration token from https://www.notion.so/my-integrations
NOTION_API_TOKEN=
