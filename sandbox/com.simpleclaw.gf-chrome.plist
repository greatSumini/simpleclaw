<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.simpleclaw.gf-chrome</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/sandbox-exec</string>
        <string>-f</string>
        <string>/Users/sumin/repos/greatSumini/claw/sandbox/gf-chrome.sb</string>
        <string>/Applications/Google Chrome.app/Contents/MacOS/Google Chrome</string>
        <string>--user-data-dir=/Users/sumin/gf-workspace/chrome</string>
        <string>--remote-debugging-port=9333</string>
        <string>--remote-allow-origins=*</string>
        <!-- Chrome's own Seatbelt sandbox cannot initialize inside the outer one. The outer
             profile is what keeps this browser away from the owner's files. -->
        <string>--no-sandbox</string>
        <!-- Without this, Chrome reads the cookie-encryption key from the login keychain, which
             gf-chrome.sb denies (~/Library/Keychains). The network service then stalls and every
             http(s) navigation hangs at about:blank while CDP itself still answers. -->
        <string>--use-mock-keychain</string>
        <string>--no-first-run</string>
        <string>--no-default-browser-check</string>
        <!-- Sit idle until the automation session opens a tab, instead of popping a window. -->
        <string>--no-startup-window</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/sumin/gf-workspace/chrome.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sumin/gf-workspace/chrome.error.log</string>
</dict>
</plist>
